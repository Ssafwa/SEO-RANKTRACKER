PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
BROWSERBASE_API_KEY=
# Browserbase proxy usage is billable and unavailable on the Free plan.
BROWSERBASE_USE_PROXY=false
AI_API_KEY=
AI_BASE_URL=https://ai.hackclub.com/proxy/v1
AI_MODEL=google/gemini-2.5-flash
FRONTEND_URL=http://localhost:5173
CRON_SECRET=replace-with-a-long-random-secret
